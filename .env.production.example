APP_NAME="SPM Seminar"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://spm.domainanda.com

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=spm
DB_USERNAME=spm
DB_PASSWORD=GANTI_PASSWORD_KUAT_DISINI
MYSQL_ROOT_PASSWORD=GANTI_ROOT_PASSWORD_KUAT_DISINI
DB_PORT_HOST=3307
NGINX_PORT=80

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# PROD: pakai SMTP asli, jangan mailpit
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=email@domainanda.com
MAIL_PASSWORD=app_password_gmail
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@domainanda.com
MAIL_FROM_NAME="${APP_NAME}"

# Matikan mailpit di prod (via docker-compose.prod.yml sudah di-profile debug)
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
VITE_APP_NAME="${APP_NAME}"
